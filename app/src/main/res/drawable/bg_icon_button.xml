<?xml version="1.0" encoding="utf-8"?>
<!-- Round icon-button shell used for settings / shop / mail entries on the home screen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#FFEFD9A8" />
            <stroke android:width="3dp" android:color="@color/crust_gold_dark" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/crust_gold_dark" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="oval">
                    <solid android:color="@color/cream" />
                    <stroke android:width="3dp" android:color="@color/crust_gold" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
