<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fitsSystemWindows="true">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_back"
        style="@style/Widget.PizzaCrash.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_m"
        android:minWidth="0dp"
        android:text="@string/action_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_title"
        android:textAppearance="@style/TextAppearance.PizzaCrash.Title"
        app:layout_constraintTop_toTopOf="@+id/button_back"
        app:layout_constraintBottom_toBottomOf="@+id/button_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_m"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_l"
        app:layout_constraintTop_toBottomOf="@+id/button_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l">

            <!-- Avatar -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_avatar_circle">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_profile" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.PizzaCrash.Title" />

            <TextView
                android:id="@+id/text_member_since"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.PizzaCrash.Caption" />

            <!-- Name editor panel -->
            <LinearLayout
                style="@style/Widget.PizzaCrash.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_display_name"
                    android:textAppearance="@style/TextAppearance.PizzaCrash.Body"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/input_display_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:hint="@string/profile_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="20"
                    android:minHeight="@dimen/touch_target_min"
                    android:textAppearance="@style/TextAppearance.PizzaCrash.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_save_name"
                    style="@style/Widget.PizzaCrash.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/profile_save" />
            </LinearLayout>

            <!-- Stats panel -->
            <LinearLayout
                style="@style/Widget.PizzaCrash.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_stats_title"
                    android:textAppearance="@style/TextAppearance.PizzaCrash.Body"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_total_stars"
                        android:textAppearance="@style/TextAppearance.PizzaCrash.Body" />

                    <TextView
                        android:id="@+id/text_total_stars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/star_amber"
                        android:textAppearance="@style/TextAppearance.PizzaCrash.Body"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_levels_completed"
                        android:textAppearance="@style/TextAppearance.PizzaCrash.Body" />

                    <TextView
                        android:id="@+id/text_levels_completed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/success_green"
                        android:textAppearance="@style/TextAppearance.PizzaCrash.Body"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_coins"
                        android:textAppearance="@style/TextAppearance.PizzaCrash.Body" />

                    <TextView
                        android:id="@+id/text_coins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/coin_gold"
                        android:textAppearance="@style/TextAppearance.PizzaCrash.Body"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_current_world"
                        android:textAppearance="@style/TextAppearance.PizzaCrash.Body" />

                    <TextView
                        android:id="@+id/text_current_world"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pizza_red"
                        android:textAppearance="@style/TextAppearance.PizzaCrash.Body"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
