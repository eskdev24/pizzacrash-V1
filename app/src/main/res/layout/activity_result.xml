<?xml version="1.0" encoding="utf-8"?>
<!-- Results screen (UI_Refs/won-completed.png + loss-fail.png): one layout, two panels. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim">

    <!-- WIN panel -->
    <LinearLayout
        android:id="@+id/panel_win"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="@dimen/space_l"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_level_complete"
            android:textColor="@color/star_amber"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/result_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textColor="@color/star_amber"
            android:textSize="34sp"
            android:text="★ ★ ★" />

        <TextView
            android:id="@+id/result_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textColor="@color/cream"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="Score 0" />

        <TextView
            android:id="@+id/result_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/coin_gold"
            android:textSize="16sp"
            android:text="+0 coins" />

        <Button
            android:id="@+id/btn_next"
            style="@style/Widget.PizzaCrash.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/action_next" />

        <Button
            android:id="@+id/btn_home"
            style="@style/Widget.PizzaCrash.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/action_home" />
    </LinearLayout>

    <!-- LOSE panel -->
    <LinearLayout
        android:id="@+id/panel_lose"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="@dimen/space_l"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_out_of_moves"
            android:textColor="@color/pizza_red"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/message_try_again"
            android:textColor="@color/cream"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_retry"
            style="@style/Widget.PizzaCrash.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/action_retry" />

        <Button
            android:id="@+id/btn_home_lose"
            style="@style/Widget.PizzaCrash.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/action_home" />
    </LinearLayout>
</FrameLayout>
