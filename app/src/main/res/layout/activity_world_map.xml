<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/map_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/board_bg"
    android:fitsSystemWindows="true">

    <!-- Top bar: back, world banner + progress, gift button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_back"
        style="@style/Widget.PizzaCrash.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_m"
        android:minWidth="0dp"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:text="@string/action_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/banner_world"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_world_banner"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_s"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_s"
        app:layout_constraintTop_toTopOf="@+id/button_back"
        app:layout_constraintBottom_toBottomOf="@+id/button_back"
        app:layout_constraintStart_toEndOf="@+id/button_back"
        app:layout_constraintEnd_toStartOf="@+id/button_gift">

        <TextView
            android:id="@+id/text_world_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PizzaCrash.Title"
            android:text="@string/world_1" />

        <TextView
            android:id="@+id/text_world_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PizzaCrash.Caption" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/button_gift"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_margin="@dimen/space_m"
        android:background="@drawable/bg_round_button"
        android:padding="@dimen/space_s"
        android:src="@drawable/ic_gift"
        android:contentDescription="@string/action_daily_reward"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Star-progress counter chip (world stars / 60) -->
    <LinearLayout
        android:id="@+id/chip_stars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip"
        android:paddingStart="@dimen/space_s"
        android:paddingEnd="@dimen/space_m"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs"
        android:layout_marginTop="@dimen/space_s"
        app:layout_constraintTop_toBottomOf="@+id/banner_world"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star_small"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/text_star_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.PizzaCrash.Body" />
    </LinearLayout>

    <!-- Scrollable meandering path; 20 level nodes added programmatically -->
    <ScrollView
        android:id="@+id/map_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_s"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_xl"
        app:layout_constraintTop_toBottomOf="@+id/chip_stars"
        app:layout_constraintBottom_toTopOf="@+id/button_prev_world">

        <LinearLayout
            android:id="@+id/map_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_l"
            android:paddingBottom="@dimen/space_l" />
    </ScrollView>

    <!-- Previous / next world navigation -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_prev_world"
        style="@style/Widget.PizzaCrash.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_m"
        android:minWidth="0dp"
        android:text="@string/action_prev_world"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_next_world"
        style="@style/Widget.PizzaCrash.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_m"
        android:minWidth="0dp"
        android:text="@string/action_next_world"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
