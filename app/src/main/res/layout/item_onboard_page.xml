<?xml version="1.0" encoding="utf-8"?>
<!-- Single onboarding page: illustration + title + body. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/space_l">

    <ImageView
        android:id="@+id/image_illustration"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.PizzaCrash.Title" />

    <TextView
        android:id="@+id/text_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.PizzaCrash.Body" />
</LinearLayout>
