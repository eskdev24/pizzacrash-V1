<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============ Text styles ============ -->
    <style name="TextAppearance.PizzaCrash.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PizzaCrash.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PizzaCrash.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.PizzaCrash.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ============ Button styles ============ -->
    <!-- Primary: red with dark-red "depth" bottom edge -->
    <style name="Widget.PizzaCrash.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/pizza_red</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">@dimen/card_corner</item>
        <item name="strokeColor">@color/pizza_red_dark</item>
        <item name="strokeWidth">2dp</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- Secondary: golden crust -->
    <style name="Widget.PizzaCrash.Button.Secondary" parent="Widget.PizzaCrash.Button.Primary">
        <item name="backgroundTint">@color/crust_gold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/crust_gold_dark</item>
    </style>

    <!-- Tertiary: outlined panel style -->
    <style name="Widget.PizzaCrash.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/panel_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">@dimen/card_corner</item>
    </style>

    <!-- ============ Panel / card styles ============ -->
    <style name="Widget.PizzaCrash.Panel" parent="">
        <item name="android:background">@drawable/bg_panel</item>
        <item name="android:padding">@dimen/space_m</item>
    </style>

    <style name="Widget.PizzaCrash.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">@dimen/space_s</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.PizzaCrash.Body</item>
    </style>
</resources>
